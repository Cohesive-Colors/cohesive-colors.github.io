{
  "name": "cohesive-colors-obsidian",
  "version": "1.0.0",
  "private": true,
  "description": "Cohesive colour palettes of 3 to 10 swatches, inside your notes.",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "lint": "eslint .",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "sync-engine": "node scripts/sync-engine.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "culori": "^4.0.1"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "obsidian": "1.14.4",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.73.0"
  }
}
