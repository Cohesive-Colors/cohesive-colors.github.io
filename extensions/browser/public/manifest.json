{
  "manifest_version": 3,
  "name": "Cohesive Colors — Palette Generator",
  "short_name": "Cohesive Colors",
  "version": "1.0.0",
  "description": "Generate cohesive colour palettes of 3 to 10 swatches, pull the palette out of any web page, and copy it as CSS, Tailwind or JSON.",
  "homepage_url": "https://cohesive-colors.github.io/",
  "action": {
    "default_title": "Cohesive Colors",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Open Cohesive Colors"
    }
  }
}
