# Public origin of the deployed site. Absolute og:image and Pinterest URLs are
# built from it. Leave it unset and the build falls back to the production
# origin baked into astro.config.mjs, which is what you want for GitHub Pages.
# Override it only for a preview deploy or a custom domain.
# PUBLIC_SITE_URL=https://cohesive-colors.github.io

# Firebase Realtime Database - optional.
# Without these the app runs entirely locally: the bundled seed feed, and likes
# kept in this browser. With them, likes are shared and palettes can be published.
#
# Values come from Firebase console > Project settings > Your apps > Web app.
# PUBLIC_ vars are exposed to the browser by design; Firebase web keys are not
# secrets, access is controlled by database.rules.json.

PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.europe-west1.firebasedatabase.app
PUBLIC_FIREBASE_PROJECT_ID=your-project
PUBLIC_FIREBASE_APP_ID=

# Only for scripts/seed-firebase.mjs (never shipped to the browser):
# path to a service-account JSON from Project settings > Service accounts
GOOGLE_APPLICATION_CREDENTIALS=
