---
const { pathname } = Astro.url;
const links = [
	{ href: '/palettes', label: 'Palettes' },
	{ href: '/generator', label: 'Generator' },
	{ href: '/saved', label: 'Saved' },
];
const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
---

<header class='sticky top-0 z-50 border-b border-line/70 bg-canvas/85 backdrop-blur'>
	<nav
		class='mx-auto flex h-14 max-w-[1400px] items-center gap-6 px-4 sm:px-6'
		aria-label='Main'>
		<a
			href='/'
			class='flex items-center gap-2 text-[14px] font-semibold tracking-tight text-ink-900'>
			<img
				src='/favicon.svg'
				alt=''
				width='28'
				height='28'
				data-pin-nopin='true'
				class='size-7 rounded-[7px]'
			/>
			Cohesive<span class='text-ink-500'>Colors</span>
		</a>

		<ul class='hidden items-center gap-1 sm:flex'>
			{links.map((link) => (
				<li>
					<a
						href={link.href}
						aria-current={isActive(link.href) ? 'page' : undefined}
						class:list={[
							'rounded-full px-3 py-1.5 text-[13px] transition',
							isActive(link.href) ? 'text-ink-900 font-medium' : 'text-ink-500 hover:text-ink-900',
						]}>
						{link.label}
					</a>
				</li>
			))}
		</ul>

		<div class='ml-auto flex items-center gap-2'>
			<a
				href='/saved'
				aria-label='Saved palettes'
				class='grid size-9 place-items-center rounded-full text-ink-500 transition hover:text-accent'>
				<svg
					viewBox='0 0 24 24'
					class='size-[18px]'
					fill='none'
					stroke='currentColor'
					stroke-width='1.8'
					aria-hidden='true'>
					<path
						d='M20.8 6.6a5 5 0 0 0-8.8-1.9 5 5 0 0 0-8.8 1.9c-.7 3 1.4 5.6 3.4 7.5L12 20l5.4-5.9c2-1.9 4.1-4.5 3.4-7.5Z'
						stroke-linejoin='round'
					/>
				</svg>
			</a>
			<a
				href='/generator'
				class='inline-flex h-9 items-center gap-1.5 rounded-full bg-ink-900 px-3.5 text-[13px] font-medium text-white transition hover:opacity-90'>
				<svg
					viewBox='0 0 24 24'
					class='size-4'
					fill='none'
					stroke='currentColor'
					stroke-width='2'
					aria-hidden='true'>
					<path
						d='M12 5v14M5 12h14'
						stroke-linecap='round'
					/>
				</svg>
				Generate
			</a>
		</div>
	</nav>

	<div class='border-t border-line/70 sm:hidden'>
		<ul class='flex items-center gap-1 overflow-x-auto px-4 py-2 scrollbar-thin'>
			{links.map((link) => (
				<li>
					<a
						href={link.href}
						aria-current={isActive(link.href) ? 'page' : undefined}
						class:list={[
							'whitespace-nowrap rounded-full px-3 py-1 text-[12.5px] transition',
							isActive(link.href) ? 'bg-ink-900 text-white' : 'text-ink-500',
						]}>
						{link.label}
					</a>
				</li>
			))}
		</ul>
	</div>
</header>
