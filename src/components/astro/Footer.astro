---
import { HUB_LINKS } from '@/lib/seo';
import LogoMarquee from './LogoMarquee.astro';

const browse = [
	{ href: '/palettes', label: 'All color palettes' },
	{ href: '/generator', label: 'Cohesive generator' },
	{ href: '/saved', label: 'Saved palettes' },
	{ href: '/about', label: 'How cohesion works' },
	{ href: '/privacy', label: 'Privacy policy' },
];

const hues = HUB_LINKS.filter((l) => l.kind === 'hue');
const moods = HUB_LINKS.filter((l) => l.kind === 'mood');
const sizes = HUB_LINKS.filter((l) => l.kind === 'size');
---

<footer class='mt-20 border-t border-line bg-surface'>
	<div class='mx-auto grid max-w-[1400px] gap-8 px-4 py-12 sm:px-6 md:grid-cols-4'>
		<div>
			<h2 class='text-[12px] font-semibold text-ink-900'>Browse</h2>
			<ul class='mt-3 space-y-2'>
				{browse.map((link) => (
					<li>
						<a
							href={link.href}
							class='text-[12.5px] text-ink-500 transition hover:text-ink-900'>
							{link.label}
						</a>
					</li>
				))}
			</ul>
		</div>

		<div>
			<h2 class='text-[12px] font-semibold text-ink-900'>By color</h2>
			<ul class='mt-3 space-y-2'>
				{hues.map((link) => (
					<li>
						<a
							href={link.href}
							class='text-[12.5px] text-ink-500 transition hover:text-ink-900'>
							{link.label}
						</a>
					</li>
				))}
			</ul>
		</div>

		<div>
			<h2 class='text-[12px] font-semibold text-ink-900'>By mood</h2>
			<ul class='mt-3 space-y-2'>
				{moods.map((link) => (
					<li>
						<a
							href={link.href}
							class='text-[12.5px] text-ink-500 transition hover:text-ink-900'>
							{link.label}
						</a>
					</li>
				))}
			</ul>
		</div>

		<div>
			<h2 class='text-[12px] font-semibold text-ink-900'>By size</h2>
			<ul class='mt-3 space-y-2'>
				{sizes.map((link) => (
					<li>
						<a
							href={link.href}
							class='text-[12.5px] text-ink-500 transition hover:text-ink-900'>
							{link.label}
						</a>
					</li>
				))}
			</ul>
		</div>
	</div>
	<LogoMarquee class='border-t border-line' />
	<div class='border-t border-line'>
		<p class='mx-auto max-w-[1400px] px-4 py-5 text-[11.5px] text-ink-300 sm:px-6'>
			&copy; 2026 Cohesive Colors. Palettes harmonised with OKLCH colour math. Everything you like
			or save stays in this browser.
		</p>
	</div>
</footer>
