---
import Layout from '@/layouts/Layout.astro';
import PaletteGrid from '@/components/astro/PaletteGrid.astro';
import HubLinks from '@/components/astro/HubLinks.astro';
import { SEED_PALETTES } from '@/lib/data/palettes';
import { ALL_MOODS } from '@/lib/color/naming';
import { slug } from '@/lib/color/export';
import { clampMeta, clampTitle, hubHref } from '@/lib/seo';
import type { Mood, Palette } from '@/lib/color/types';

const BLURB: Record<string, string> = {
  Pastel: 'High lightness, low chroma. Soft enough for large surfaces without washing text out.',
  Vibrant: 'High chroma held together by one key colour, so the saturation reads as deliberate.',
  Muted: 'Low chroma throughout. Atmospheric rather than loud, and forgiving in large areas.',
  Dark: 'Weighted towards the low end of the lightness ramp, built for dark interfaces.',
  Earthy: 'Warm hues at moderate chroma, the range you get from clay, wood and soil.',
  Nordic: 'Cool blues and greys at low chroma, the restrained end of the spectrum.',
  Cyberpunk: 'High chroma against dark ground, leaning on magenta, cyan and violet.',
  Retro: 'Mid chroma in warm hues, the register of print from a few decades ago.',
  'Warm Sunset': 'Ambers, oranges and reds, the hues of low light late in the day.',
  Monochrome: 'One hue family, separated by lightness and chroma instead of by hue.',
};

export function getStaticPaths() {
  return ALL_MOODS.map((mood) => ({
    params: { mood: slug(mood) },
    props: {
      mood,
      palettes: SEED_PALETTES.filter((p) => p.moods.includes(mood as Mood)).sort(
        (a, b) => b.colors.length - a.colors.length,
      ),
    },
  }));
}

interface Props {
  mood: string;
  palettes: Palette[];
}

const { mood, palettes } = Astro.props;
const site = Astro.site ?? Astro.url;
const lower = mood.toLowerCase();

const title = clampTitle(`${mood} color palettes with hex codes`, 46);
const description = clampMeta(
  `${palettes.length} ${lower} color palettes with hex codes, 3 to 10 swatches each, harmonised in OKLCH with contrast ratios and code exports.`,
);

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Palettes', item: new URL('/palettes', site).href },
        { '@type': 'ListItem', position: 2, name: `${mood} palettes`, item: new URL(hubHref('mood', mood), site).href },
      ],
    },
    {
      '@type': 'CollectionPage',
      name: title,
      description,
      url: new URL(Astro.url.pathname, site).href,
      isPartOf: { '@type': 'WebSite', name: 'Cohesive Colors', url: new URL('/', site).href },
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: palettes.length,
        itemListElement: palettes.slice(0, 30).map((p, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: p.name,
          url: new URL(`/palette/${slug(p.name)}-palette-${p.id}`, site).href,
        })),
      },
    },
  ],
};
---

<Layout title={title} description={description}>
  <nav aria-label="Breadcrumb" class="text-[12px] text-ink-500">
    <a href="/" class="hover:text-ink-900">Home</a>
    <span class="mx-1.5 text-ink-300">/</span>
    <a href="/palettes" class="hover:text-ink-900">Palettes</a>
    <span class="mx-1.5 text-ink-300">/</span>
    <span class="text-ink-900">{mood}</span>
  </nav>

  <h1 class="mt-3 text-[26px] font-semibold tracking-tight text-ink-900">{mood} color palettes</h1>
  <p class="mt-2 max-w-2xl text-[13.5px] leading-relaxed text-ink-500">
    {BLURB[mood] ?? `${palettes.length} palettes in this register.`} Classified from the finished
    swatches, not from the recipe that produced them.
  </p>

  <PaletteGrid palettes={palettes} />
  <HubLinks title="Other collections" exclude={hubHref('mood', mood)} />

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</Layout>
