{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/lib/firebase/config": ["./src/shims/firebase-config.ts"],
      "@/lib/firebase/client": ["./src/shims/firebase-client.ts"],
      "@/store/useAppStore": ["./src/store/useAppStore.ts"],
      "@/*": ["../src/*"],
      "~/*": ["./src/*"],
      "culori": ["./node_modules/@types/culori"],
      "zustand": ["./node_modules/zustand"],
      "zustand/*": ["./node_modules/zustand/*"],
      "firebase/*": ["./node_modules/firebase/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
