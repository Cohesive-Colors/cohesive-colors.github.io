# Firebase (optional) — the same web config the site uses, with EXPO_PUBLIC_ in
# front instead of PUBLIC_. Without these the app runs fully offline: bundled
# palettes, likes kept on the device, no publishing.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.europe-west1.firebasedatabase.app
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_APP_ID=

# Public origin of the website, used for share links.
EXPO_PUBLIC_SITE_URL=https://cohesive-colors.github.io
